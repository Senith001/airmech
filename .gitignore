# ── Secrets & credentials ───────────────────────────────────────────────────
# Never commit real credentials. Copy .env.example → .env and fill in values.
.env

# wp-config.php is auto-generated by Docker from environment variables.
# Each developer gets their own copy — do not commit it.
wp-config.php

# ── WordPress generated / runtime files ─────────────────────────────────────
error_log
*.log
debug.log
wp-content/debug.log

# WP auto-update scratch dirs
wp-content/upgrade/
wp-content/upgrade-temp-backup/

# Elementor & plugin caches (regenerated automatically)
wp-content/cache/
wp-content/et-cache/
wp-content/uploads/elementor/css/
wp-content/uploads/elementor/tmp/

# WooCommerce generated logs
wp-content/uploads/wc-logs/

# ── OS noise ────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Node (not used in production but may appear during dev) ─────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Stale / superseded files ────────────────────────────────────────────────
# The old SQL seed at repo root is replaced by backups/airmech-current.sql
airmechl_airmechwebdb.sql

# ── Temp / scratch ──────────────────────────────────────────────────────────
wp-content/temp-write-test*
