# MySQL Database Configuration
# These settings configure the MySQL database container
MYSQL_DATABASE=wellknown_db
MYSQL_USER=wp_user
MYSQL_PASSWORD=wp_password
MYSQL_ROOT_PASSWORD=root_password

# WordPress Database Configuration
# These settings are passed to WordPress to connect to the database
WORDPRESS_DB_NAME=wellknown_db
WORDPRESS_DB_USER=wp_user
WORDPRESS_DB_PASSWORD=wp_password
WORDPRESS_DB_HOST=db:3306

# WordPress Debug Mode
# Set to 1 to enable debug mode, 0 to disable
WORDPRESS_DEBUG=1